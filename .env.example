# Copy this file to .env.local, or run: npm run setup
# With Kinde left empty, Earmark runs on your machine with a local account and a built-in stand-in for the plan limit and the meter.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex. `npx convex dev` fills in NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
# A long random string. Set the same value in .env.local and on the Convex deployment (npm run setup does both).
EARMARK_SERVER_KEY=

# Kinde: sign-in for the website
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/app
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# Set on the Convex deployment, not here, to read the limit from Kinde and report usage to it:
#   npx convex env set PROVIDER kinde
#   npx convex env set KINDE_DOMAIN https://yourdomain.kinde.com
#   npx convex env set KINDE_M2M_CLIENT_ID ...
#   npx convex env set KINDE_M2M_CLIENT_SECRET ...
# The machine-to-machine app needs the read:billing_entitlements and create:meter_usage scopes.
# Set PROVIDER=kinde here too, so the dashboard shows the Kinde settings and hides the lab.
PROVIDER=
